# =============================================================================
# TheHive — Play Framework Secret Key TEMPLATE
# =============================================================================
# STEP: Copy this file to secret.conf
#   cp thehive/config/secret.conf.template thehive/config/secret.conf
#
# THEN: Replace ###CHANGEME_THEHIVE_SECRET### below with a long random string.
#
# Generate one with:
#   openssl rand -base64 48
#
# EXAMPLE:
#   play.http.secret.key="xK92mZpL3QnRvTwYsAjDgFbHcUoEiNtXyWkO1VhMlPuCeB8rS0qZfJ"
#
# ┌──────────────────────────────────────────────────────────────────────────┐
# │  FILE                     │  PLACEHOLDER                   │  VALUE     │
# ├──────────────────────────────────────────────────────────────────────────┤
# │  thehive/config/secret.conf│ ###CHANGEME_THEHIVE_SECRET###  │ random str │
# │  cortex/config/secret.conf │ ###CHANGEME_CORTEX_SECRET###   │ random str │
# └──────────────────────────────────────────────────────────────────────────┘
# NOTE: This is NOT the Elasticsearch password.
#       This is a Play framework session encryption key.
#       TheHive and Cortex must each have a DIFFERENT secret key.
# =============================================================================

# ↓ REPLACE THIS with your generated secret key
play.http.secret.key="###CHANGEME_THEHIVE_SECRET###"
