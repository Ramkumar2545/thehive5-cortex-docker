server {
  listen 443 ssl;
  server_name ${SERVER_NAME};

  ssl_certificate /etc/nginx/certs/thehive.crt;
  ssl_certificate_key /etc/nginx/certs/thehive.key;
  ssl_trusted_certificate ${NGINX_SSL_TRUSTED_CERTIFICATE};

  client_max_body_size 200M;

  location /thehive/ {
    proxy_pass http://thehive:9000/thehive/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
  }

  location /cortex/ {
    proxy_pass http://cortex:9001/cortex/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
  }
}
