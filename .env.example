# =============================================================================
# TheHive 5 + Cortex 4 — Environment Configuration
# =============================================================================
# STEP: This file is copied to .env by ./scripts/init.sh
#   cp .env.example .env
#
# Then edit .env and replace every placeholder value below.
# =============================================================================

# ─── Linux user ───────────────────────────────────────────────────────
# Run: id -u   and   id -g   to get your values
UID=1000
GID=1000

# ─── Elasticsearch ────────────────────────────────────────────────
# This password is used by Docker Compose to set the Elasticsearch
# 'elastic' user password AND must match the password in:
#   thehive/config/index.conf
#   cortex/config/index.conf
ELASTICSEARCH_PASSWORD=ChangeThisElasticPassword123!

# ─── Cortex analyzer jobs ─────────────────────────────────────────
# MUST be an ABSOLUTE host path — Docker passes this directly to
# spawned analyzer sub-containers as a bind-mount source.
#
# HOW TO SET THIS:
#   Run: echo "$(pwd)/cortex/cortex-jobs"
#   Copy that output here.
#
# WRONG (relative path — Docker cannot resolve it):
#   CORTEX_DOCKER_JOB_DIRECTORY=./cortex/cortex-jobs
#
# CORRECT (absolute path example — replace with YOUR actual path):
#   CORTEX_DOCKER_JOB_DIRECTORY=/home/youruser/thehive5-cortex-docker/cortex/cortex-jobs
#
# NOTE: If this path is wrong or the directory does not exist on the host,
#       Cortex workers will start but receive empty stdin, causing:
#       json.decoder.JSONDecodeError: Expecting value: line 1 column 1 (char 0)
CORTEX_DOCKER_JOB_DIRECTORY=/home/youruser/thehive5-cortex-docker/cortex/cortex-jobs

# ─── Nginx ───────────────────────────────────────────────────────────
NGINX_SERVER_NAME=localhost
NGINX_SSL_TRUSTED_CERTIFICATE=/etc/nginx/certs/thehive-ca.crt

# ─── Play framework secret keys ──────────────────────────────────
# These are NOT the Elasticsearch password.
# Generate with: openssl rand -base64 48
# TheHive and Cortex must each have a DIFFERENT secret.
THEHIVE_SECRET=ChangeThisTheHiveSecretValue
CORTEX_SECRET=ChangeThisCortexSecretValue

# ─── Post-install: Analyzer rate limiting ─────────────────────────────
# These are NOT .env variables — Cortex has no env-driven rate limit
# setting. Set them manually, per-analyzer, after first login:
#
# After first login, set Rate Limiting on each analyzer in
# Cortex UI > Organization > Analyzers > [analyzer] > Options > Rate Limiting:
#   VirusTotal: 4 per Minute (hard API limit)
#   AlienVault OTX: 150 per Minute (conservative buffer under 10k/hour key limit)
#   MalwareBazaar: 60 per Minute (self-imposed, no official hard limit)
#   ThreatFox: 60 per Minute (self-imposed, no official hard limit)
#   CIRCLHashlookup: 30 per Minute (self-imposed, best-effort free service)
# See TROUBLESHOOTING.md for full rationale.

# =============================================================================
# Image versions — DO NOT change unless you know what you are doing
# =============================================================================
cassandra_image_version=4.1.10
elasticsearch_image_version=8.19.11
thehive_image_version=5.6.0
cortex_image_version=4.0.0
nginx_image_version=1.29.5
