# =============================================================================
# Cortex — Play Framework Secret Key TEMPLATE
# =============================================================================
# STEP: Copy this file to secret.conf
#   cp cortex/config/secret.conf.template cortex/config/secret.conf
#
# THEN: Replace ###CHANGEME_CORTEX_SECRET### below with a long random string.
#
# Generate one with:
#   openssl rand -base64 48
#
# EXAMPLE:
#   play.http.secret.key="aB7nWqRpKsLmXoVtGcYeJfHiUdMzNwTyPbCgFkDsElOr2vQ9hZ5uX3j"
#
# ┌──────────────────────────────────────────────────────────────────────────┐
# │  FILE                     │  PLACEHOLDER                   │  VALUE     │
# ├──────────────────────────────────────────────────────────────────────────┤
# │  thehive/config/secret.conf│ ###CHANGEME_THEHIVE_SECRET###  │ random str │
# │  cortex/config/secret.conf │ ###CHANGEME_CORTEX_SECRET###   │ random str │
# └──────────────────────────────────────────────────────────────────────────┘
# NOTE: This is NOT the Elasticsearch password.
#       This is a Play framework session encryption key.
#       Cortex and TheHive must each have a DIFFERENT secret key.
# =============================================================================

# ↓ REPLACE THIS with your generated secret key
play.http.secret.key="###CHANGEME_CORTEX_SECRET###"
